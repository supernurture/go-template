# Secrets & config
# Mounted at runtime: anything copied stays readable in the image layer.
.env
configs/config.yaml

# Version control
# Large, and the build never reads it.
.git
.gitignore

# IDE
.idea/
.vscode/

# Logs
logs/

# Go binaries & build output
# Host builds, likely the wrong architecture.
bin/
dist/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test & coverage
*.test
*.out
coverage.*

# Docs & build files
# Not needed to compile; a README edit should not invalidate the build cache.
Dockerfile
.dockerignore
Makefile
README.md

# OS
.DS_Store
Thumbs.db
