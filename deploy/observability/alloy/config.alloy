// Ships the JSON logs `make run` writes under ./logs (logger.path) to Loki. trace_id, span_id and
// request_id are structured metadata, not labels: unique per request, each would start its own stream.

local.file_match "app" {
	path_targets = [{"__path__" = "/project/logs/*/*.log"}]
}

loki.source.file "app" {
	targets    = local.file_match.app.targets
	forward_to = [loki.process.app.receiver]
}

loki.process "app" {
	stage.json {
		expressions = {
			service_name = "application_name",
			level        = "level",
			ts           = "timestamp",
			trace_id     = "trace_id",
			span_id      = "span_id",
			request_id   = "request_id",
		}
	}

	// The line's own time, not the moment Alloy read it.
	stage.timestamp {
		source = "ts"
		format = "RFC3339Nano"
	}

	// service_name matches the OTLP service.name Tempo stores, so a trace links to its logs.
	stage.labels {
		values = {service_name = "", level = ""}
	}

	stage.structured_metadata {
		values = {trace_id = "", span_id = "", request_id = ""}
	}

	forward_to = [loki.write.lgtm.receiver]
}

loki.write "lgtm" {
	endpoint {
		url = "http://lgtm:3100/loki/api/v1/push"
	}
}
