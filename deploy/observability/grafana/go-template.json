          },
          "expr": "sum by (level) (count_over_time({service_name=\"$service\", level=~\"$level\"} |= `$trace_id` |= `$request_id` |~ `(?i)$search` [$__auto]))",
          "legendFormat": "{{level}}",
          "queryType": "range"
        }
      ],
      "description": "Lines per interval that match every search box above.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
