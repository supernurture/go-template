      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=\"$service\",span_kind=\"SPAN_KIND_SERVER\",span_name=~\"${route:regex}\"}[$__rate_interval])))",
          "legendFormat": "p50",
