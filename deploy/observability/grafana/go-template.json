{
  "uid": "go-template-overview",
  "title": "go-template \u2014 logs, traces, metrics",
  "tags": [
    "go-template",
    "opentelemetry"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds_prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "ds_loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "hide": 0,
        "current": {
          "text": "Loki",
          "value": "loki"
        }
      },
      {
        "name": "ds_tempo",
        "label": "Tempo",
        "type": "datasource",
        "query": "tempo",
        "hide": 0,
        "current": {
          "text": "Tempo",
          "value": "tempo"
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prometheus}"
        },
        "hide": 0,
        "refresh": 2,
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total, service)",
          "refId": "service"
        },
        "definition": "label_values(traces_spanmetrics_calls_total, service)",
        "current": {
          "text": "go-template",
          "value": "go-template"
        }
      },
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prometheus}"
        },
        "hide": 0,
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total{service=\"$service\",span_kind=\"SPAN_KIND_SERVER\"}, span_name)",
          "refId": "route"
        },
        "definition": "label_values(traces_spanmetrics_calls_total{service=\"$service\",span_kind=\"SPAN_KIND_SERVER\"}, span_name)",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "level",
        "label": "Log level",
        "type": "custom",
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "query": "DEBUG,INFO,WARN,ERROR",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "min_duration",
        "label": "Min duration",
        "type": "custom",
        "hide": 0,
        "query": "0ms,5ms,10ms,50ms,100ms,500ms,1s",
        "current": {
          "text": "0ms",
          "value": "0ms"
        },
        "options": []
      },
      {
        "name": "search",
        "label": "Search logs",
        "type": "textbox",
        "query": "",
        "hide": 0,
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Case-insensitive regex over the whole log line."
      },
      {
        "name": "trace_id",
        "label": "trace_id",
        "type": "textbox",
        "query": "",
        "hide": 0,
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Filters logs to one trace and opens it in 'Trace by trace_id'."
      },
      {
        "name": "request_id",
        "label": "request_id",
        "type": "textbox",
        "query": "",
        "hide": 0,
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Filters logs to one request (the X-Request-ID header)."
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Explore traces",
      "type": "link",
      "icon": "external link",
      "targetBlank": true,
      "url": "/explore?left={\"datasource\": \"tempo\", \"queries\": [{\"refId\": \"A\", \"queryType\": \"traceql\", \"query\": \"{resource.service.name=\\\"go-template\\\"}\"}]}"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview \u2014 rate, errors, duration (span metrics)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests / s",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"$service\",span_kind=\"SPAN_KIND_SERVER\",span_name=~\"${route:regex}\"}[$__rate_interval]))",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "description": "Server spans per second, all selected routes.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error ratio",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "(sum(rate(traces_spanmetrics_calls_total{service=\"$service\",span_kind=\"SPAN_KIND_SERVER\",span_name=~\"${route:regex}\",status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) or vector(0)) / sum(rate(traces_spanmetrics_calls_total{service=\"$service\",span_kind=\"SPAN_KIND_SERVER\",span_name=~\"${route:regex}\"}[$__rate_interval]))",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "description": "Share of server spans with status ERROR: 5xx responses, and handlers that called c.Error. A 4xx is the caller's mistake and does not count; its reason is on the access-log line.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 latency",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=\"$service\",span_kind=\"SPAN_KIND_SERVER\",span_name=~\"${route:regex}\"}[$__rate_interval])))",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "description": "95th percentile server span duration.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
