      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "sum(count_over_time({service_name=\"$service\"} |= `\"message\":\"request\"` | json status | status >= 500 [$__range])) or vector(0)",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "description": "Access-log lines with status >= 500 in the time range. Unlike span status, this counts only server faults.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "ERROR log lines",
      "gridPos": {
        "h": 4,
