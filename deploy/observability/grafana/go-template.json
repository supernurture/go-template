            "uid": "${ds_prometheus}"
          },
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"$service\",span_kind=\"SPAN_KIND_SERVER\",span_name=~\"${route:regex}\"}[$__rate_interval]))",
