      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "sum(increase(traces_spanmetrics_calls_total{service=\"$service\",span_kind=\"SPAN_KIND_SERVER\",span_name=~\"${route:regex}\"}[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "description": "Server spans over the dashboard's time range.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "HTTP 5xx (access log)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
