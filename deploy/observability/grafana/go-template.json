    {
      "id": 17,
      "type": "table",
      "title": "Top failing paths (4xx / 5xx)",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 31
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "topk(10, sum by (method, path, status) (count_over_time({service_name=\"$service\"} |= `\"message\":\"request\"` | json method, path, status | status >= 400 [$__range])))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "description": "Paths answering 4xx or 5xx most often in the time range.",
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ],
            "mode": "seriesToRows"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Field": "Request",
              "Last *": "Count"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Count",
            "desc": true
          }
        ]
      }
